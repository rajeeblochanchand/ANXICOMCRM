# Session pooler URI from Supabase → Database → Connection string. The publishable/secret API keys cannot log in to Postgres.
ConnectionStrings__DefaultConnection="Host=YOUR-SESSION-POOLER;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT;Password=YOUR_PASSWORD;SSL Mode=VerifyFull"
Jwt__Key="REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES"
Jwt__Issuer="AcxiomCRM.Api"
Jwt__Audience="AcxiomCRM.Web"
AllowedOrigins="http://localhost:3000,https://YOUR_FRONTEND.vercel.app"
Auth__AllowRegistration=false
Bootstrap__Email="YOUR_ADMIN_EMAIL"
Bootstrap__Password="YOUR_STRONG_ADMIN_PASSWORD"
